# Secrets / local environment — never commit real keys
.env
.env.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Go
*.test
coverage.out
coverage.html

# Node / frontend
node_modules/
dist/
*.tsbuildinfo

# OS / editor
.DS_Store
prescriptive-guidance.pdf

# Generated pitch documents — built locally from scripts/generate_pitch*.py
*.docx
*.pptx
*.xlsx

# Vault dev credentials — generated by scripts/vault-setup.sh, never commit
.vault-dev-creds
.vault-payments-ca.pem
.vault-payment-cert.pem
.vault-payment-key.pem

# Terraform — state files contain secrets (passwords, tokens); never commit.
# Remote state is in S3 (infra/terraform/aws/backend.tf).
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
*.auto.tfvars
*.tfvars
!*.tfvars.example

# Locally-downloaded CLI binaries — never commit
*.exe

# Claude Code internal files (settings, memory) — do not commit
.claude/
# ...but project-level skills are shared config and should be versioned
!.claude/skills/
!.claude/skills/**
